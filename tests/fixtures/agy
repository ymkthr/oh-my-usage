#!/bin/sh
for arg; do
    if [ "$previous" = --log-file ]; then
        printf '%s\n' 'I1124 18:32:31.986769 1 server_oauth.go:226] OAuth: authenticated successfully as agy@example.com' > "$arg"
    fi
    previous=$arg
done
if [ "${FAKE_AGY_MODE:-ok}" = fail ]; then
    printf '%s\n' 'fake-agy: unavailable' >&2
    exit 1
fi
if [ "${FAKE_AGY_MODE:-ok}" = invalid ]; then
    printf '%s\n' 'not json'
    exit 0
fi
cat "$(dirname "$0")/agy-usage.json"
